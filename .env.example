# Copy to .env and fill in. Generate secrets with: openssl rand -hex 24

# Admin UI login (HTTP basic auth). The password is required.
COMPORTA_ADMIN_USER=admin
COMPORTA_ADMIN_PASSWORD=change-me

# One token per MCP client, as label:token pairs separated by commas
# (each token at least 16 characters). The label shows up in the audit log.
COMPORTA_MCP_TOKENS=claude-code:replace-with-a-long-random-token,copilot:replace-with-another-long-token

# Passphrase that encrypts the stored connection strings. When empty, a random
# key is created in /data/secret.key. Changing it later makes the stored
# connection strings unreadable.
COMPORTA_SECRET_KEY=

# Days to keep audit records, and the most rows any query may return.
COMPORTA_LOG_RETENTION_DAYS=30
COMPORTA_MAX_ROWS_CAP=1000

# Host port for docker compose (always bound to 127.0.0.1).
COMPORTA_PORT=7843
