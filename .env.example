# UI de administração (HTTP basic auth). Obrigatória.
COMPORTA_ADMIN_USER=admin
COMPORTA_ADMIN_PASSWORD=troque-isto

# Um token por cliente MCP, rotulo:token separados por vírgula (mín. 16 caracteres).
# O rótulo aparece na auditoria. Gere com: openssl rand -hex 24
COMPORTA_MCP_TOKENS=claude-code:troque-por-um-token-longo,copilot:troque-por-outro-token-longo

# Criptografa as connection strings guardadas. Vazio: gera uma chave em /data/secret.key.
# Trocar depois torna as connection strings guardadas ilegíveis.
COMPORTA_SECRET_KEY=

# Retenção da auditoria e teto global de linhas por consulta.
COMPORTA_LOG_RETENTION_DAYS=30
COMPORTA_MAX_ROWS_CAP=1000

# Porta no host para o docker compose (sempre em 127.0.0.1).
COMPORTA_PORT=7843
