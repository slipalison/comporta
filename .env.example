# Admin UI (HTTP basic auth). Required.
DBMCP_ADMIN_USER=admin
DBMCP_ADMIN_PASSWORD=change-me

# One token per MCP client, label:token separated by commas (min. 16 chars).
# The label shows up in the audit log. Generate with: openssl rand -hex 24
DBMCP_MCP_TOKENS=claude-code:replace-with-a-long-random-token,copilot:replace-with-another-long-token

# Encrypts connection strings at rest. If empty, a key is generated in /data/secret.key.
# Changing it later makes the stored connection strings unreadable.
DBMCP_SECRET_KEY=

# Audit log retention and global row cap per query.
DBMCP_LOG_RETENTION_DAYS=30
DBMCP_MAX_ROWS_CAP=1000

# Host port for docker compose (bound to 127.0.0.1).
DBMCP_PORT=7843
